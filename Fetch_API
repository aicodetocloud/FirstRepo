import json

def fetch_json_file(filepath):
    """
    Reads a JSON file from the given filepath and returns a Python object.
    """
    try:
        # Open the file in read mode ('r') using a 'with' statement for proper closing
        with open(filepath, 'r') as file:
            # Use json.load() to deserialize the file content into a Python dictionary
            data = json.load(file)
            return data
    except FileNotFoundError:
        print(f"Error: The file '{filepath}' was not found.")
        return None
    except json.JSONDecodeError as e:
        print(f"Error: Failed to decode JSON from the file. Details: {e}")
        return None

# Fetch the data from the 'data.json' file
json_data = fetch_json_file('data.json')

# Check if data was successfully fetched and print it
if json_data:
    print("JSON data fetched successfully:")
    print(json_data)
    print("\nAccessing specific data points:")
    print(f"Name: {json_data['name']}")
    print(f"City: {json_data['address']['city']}")
    print(f"Second Role: {json_data['roles'][1]}")
